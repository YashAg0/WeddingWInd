generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                    @id @default(uuid())
  email                  String                    @unique
  clerkUserId            String                    @unique
  name                   String?
  avatar                 String?
  role                   UserRole                  @default(TRAVELER)
  status                 UserStatus                @default(ONBOARDING)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  deletedAt              DateTime?
  agentProfile           AgentProfile?
  referralsReceived      AgentReferral[]           @relation("ReferredUser")
  cancellationsRequested CancellationRequest[]     @relation("CancellationRequestedBy")
  cancellationsReviewed  CancellationRequest[]     @relation("CancellationReviewedBy")
  reviewedAppeals        CaseAppeal[]              @relation("AppealReviewedBy")
  submittedAppeals       CaseAppeal[]              @relation("AppealSubmittedBy")
  caseEvidence           CaseEvidence[]
  caseParticipants       CaseParticipant[]
  timelineEvents         CaseTimelineEvent[]
  conversations          ConversationParticipant[]
  coordinatorProfile     CoordinatorProfile?
  coupleProfile          CoupleProfile?
  messages               Message[]
  reactions              MessageReaction[]
  notifications          Notification[]
  recentlyViewed         RecentlyViewed[]
  reviewAppealsReviewed  ReviewAppeal[]            @relation("ReviewAppealReviewedBy")
  reviewAppealsSubmitted ReviewAppeal[]            @relation("ReviewAppealSubmittedBy")
  fraudSignalsResolved   ReviewFraudSignal[]
  helpfulVotesSubmitted  ReviewHelpfulVote[]
  moderatorActions       ReviewModerationAction[]
  repliesSubmitted       ReviewReply[]
  reportsSubmitted       ReviewReport[]
  assignedSafetyCases    SafetyCase[]              @relation("SafetyAssignedAdmin")
  reportedSafetyCases    SafetyCase[]              @relation("SafetyReportedBy")
  subjectSafetyCases     SafetyCase[]              @relation("SafetySubjectUser")
  savedSearches          SavedSearch[]
  travelerProfile        TravelerProfile?
  badges                 UserQualityBadge[]
  restrictionsCreated    UserRestriction[]         @relation("RestrictionsCreatedBy")
  restrictionsRevoked    UserRestriction[]         @relation("RestrictionsRevokedBy")
  restrictions           UserRestriction[]         @relation("UserRestrictions")
  deviceSessions         UserDeviceSession[]
  verification           Verification?
  hostApplications       HostApplication[]
  hostDocumentRequests   HostDocumentRequest[]
  hostDocuments          HostDocument[]

  @@index([email])
  @@index([clerkUserId])
  @@index([status])
  @@index([createdAt])
}

model TravelerProfile {
  id              String     @id @default(uuid())
  userId          String     @unique
  fullName        String
  country         String
  language        String
  interests       String?
  budget          String     @default("1000")
  preferences     String     @default("Traditional")
  foodPreferences String     @default("No Restrictions")
  accessibility   String     @default("None")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  bookings        Booking[]
  reviews         Review[]
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlists       Wishlist[]

  @@index([userId])
}

model CoupleProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  weddingDate              DateTime?
  weddingLocation          String?
  expectedGuests           Int       @default(200)
  traditions               String?
  languagesSpoken          String?
  photographyRules         String    @default("Allowed")
  familyBio                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean   @default(false)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddings                 Wedding[]
  hostApplications         HostApplication[]

  @@index([userId])
}

model AgentProfile {
  id                       String          @id @default(uuid())
  userId                   String          @unique
  organization             String
  country                  String
  experienceYears          Int             @default(2)
  targetAudience           String?
  verifiedChecks           Boolean         @default(false)
  referralCode             String          @unique
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  deletedAt                DateTime?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean         @default(false)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals                AgentReferral[] @relation("Agent")
  commissions              Commission[]
  payoutRequests           PayoutRequest[]

  @@index([userId])
}

model CoordinatorProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  city               String
  eventExperience    String
  availability       String
  languages          String
  status             String    @default("PENDING")
  assignedEventTitle String?
  assignedDate       String?
  assignedWeddingId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedWedding    Wedding?  @relation(fields: [assignedWeddingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignedWeddingId])
}

model Wedding {
  id                  String                 @id @default(uuid())
  hostCoupleId        String
  slug                String                 @unique
  title               String
  description         String
  location            String
  category            String
  religion            String                 @default("Hindu")
  region              String?
  community           String?
  foodContext         String?
  dressExpectations   String?
  guestRules          String?
  etiquetteNotes      String?
  date                DateTime
  pricePerGuest       Float
  capacity            Int
  requiredGuests      Int                    @default(0)
  theme               String?
  dressCode           String?
  ethnicity           String?
  mainImageUrl        String
  tier                String                 @default("STANDARD")
  durationDays        Int                    @default(1)
  experienceIntensity String                 @default("TRADITIONAL")
  ceremoniesCount     Int                    @default(3)
  weddingScale        String                 @default("MEDIUM")
  status              WeddingStatus          @default(DRAFT)
  featured            Boolean                @default(false)
  manualTrendingBoost Float                  @default(0.0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  suspended           Boolean                @default(false)
  deletedAt           DateTime?
  isDemo              Boolean                @default(false)
  sponsored           Boolean                @default(false)
  sponsorshipStart    DateTime?
  sponsorshipEnd      DateTime?
  bookings            Booking[]
  contacts            EventContact[]
  recentlyViewed      RecentlyViewed[]
  safetyCases         SafetyCase[]
  hostCouple          CoupleProfile          @relation(fields: [hostCoupleId], references: [id], onDelete: Cascade)
  announcements       WeddingAnnouncement[]
  events              WeddingEvent[]
  gallery             WeddingGallery[]
  itinerary           WeddingItineraryItem[]
  badges              WeddingQualityBadge[]
  traditions          WeddingTradition[]
  wishlists            Wishlist[]
  coordinators         CoordinatorProfile[]
  sponsorshipRequests  SponsorshipRequest[]
  hostApplications     HostApplication[]

  @@index([hostCoupleId])
  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([sponsored])
  @@index([isDemo])
  @@index([createdAt])
  @@index([status, suspended, deletedAt, date])
  @@index([status, featured, sponsored])
  @@index([sponsored, sponsorshipStart, sponsorshipEnd])
  @@index([religion])
  @@index([category])
  @@index([tier])
  @@index([pricePerGuest])
}

model SponsorshipRequest {
  id                    String                   @id @default(uuid())
  weddingId             String
  coupleId              String
  promotionType         String?                  @default("SPONSORED") // SPONSORED, FEATURED
  status                SponsorshipRequestStatus @default(PENDING)
  source                String?                  @default("HOST_REQUEST") // HOST_REQUEST, ADMIN_OUTREACH, PARTNER, MANUAL, OTHER
  contactMethod         String?                  // WHATSAPP, PHONE, EMAIL, IN_PERSON, WEBSITE, OTHER
  contactDate           DateTime?
  contactNotes          String?
  agreementNotes        String?
  message               String?
  budget                String?
  proposedAmount        Float?
  requestedDurationDays Int?                     @default(7)
  amount                Float?
  currency              String                   @default("USD")
  durationDays          Int?                     @default(7)
  startsAt              DateTime?
  endsAt                DateTime?
  approvedAt            DateTime?
  approvedBy            String?
  paymentRequired       Boolean                  @default(true)
  paymentMethod         String?                  @default("UPI") // UPI, PAYPAL, BANK_TRANSFER, CASH, OTHER, WAIVED
  paymentStatus         String?                  @default("PENDING") // NOT_REQUESTED, PAYMENT_REQUESTED, PAYMENT_SUBMITTED, PAYMENT_VERIFIED, REJECTED, WAIVED
  paymentProvider       String?
  paymentReference      String?                  // UTR number, PayPal txn ID, or Bank wire ref
  paymentLink           String?                  // Configured official payment link or deep link
  paymentProofUrl       String?                  // Secure uploaded payment receipt/screenshot
  paymentProofUploadedAt DateTime?
  paymentSubmittedAt    DateTime?
  paymentVerifiedAt     DateTime?
  paymentVerifiedBy     String?
  paymentNotes          String?
  checklist             Json?                    // Server-backed 10-step progress checklist with completedBy and completedAt
  paidAt                DateTime?
  activatedAt           DateTime?
  revokedAt             DateTime?
  revokedBy             String?
  revocationReason      String?
  rejectionReason       String?
  adminNotes            String?
  requestedAt           DateTime                 @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @default(now()) @updatedAt
  wedding               Wedding                  @relation(fields: [weddingId], references: [id], onDelete: Restrict)

  @@index([weddingId, status])
  @@index([weddingId])
  @@index([coupleId])
  @@index([status])
  @@index([promotionType])
  @@index([paymentStatus])
  @@index([source])
  @@index([requestedAt])
  @@index([startsAt, endsAt])
}

model SponsorshipPaymentConfig {
  id                        String   @id @default("default")
  upiId                     String?  @default("namaste@okhdfcbank")
  upiName                   String?  @default("WeddingWithIndia")
  upiQrImageUrl             String?
  upiPaymentLink            String?
  upiInstructions           String?  @default("Scan the QR code or pay to the UPI ID. Enter the 12-digit UTR/Reference number below.")
  paypalPaymentLink         String?  @default("https://paypal.me/weddingwithindia")
  paypalDisplayName         String?  @default("WeddingWithIndia")
  paypalInstructions        String?  @default("Click the secure PayPal link to complete payment, then submit your transaction ID.")
  bankTransferInstructions  String?  @default("Transfer to: WeddingWithIndia Experiences Pvt Ltd, HDFC Bank, A/C: 50200012345678, IFSC: HDFC0000123")
  otherPaymentInstructions  String?
  updatedAt                 DateTime @default(now()) @updatedAt
  updatedBy                 String?
}

model WeddingGallery {
  id        String   @id @default(uuid())
  weddingId String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model WeddingEvent {
  id          String   @id @default(uuid())
  weddingId   String
  name        String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  location    String
  dressCode   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model WeddingTradition {
  id          String   @id @default(uuid())
  weddingId   String
  name        String
  description String
  createdAt   DateTime @default(now())
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Booking {
  id                              String                @id @default(uuid())
  travelerId                      String
  weddingId                       String
  date                            DateTime
  guestsCount                     Int                   @default(1)
  pricePerGuest                   Float
  totalAmount                     Float
  weddingTier                     String                @default("STANDARD")
  durationDays                    Int                   @default(1)
  customerPricePerGuestUSD        Float                 @default(149)
  hostPayoutPerGuestINR           Float                 @default(5101)
  agentPayoutPerGuestINR          Float                 @default(511)
  eligibleInternationalGuestCount Int                   @default(1)
  totalHostPayoutINR              Float                 @default(5101)
  totalAgentPayoutINR             Float                 @default(0)
  pricingVersion                  String                @default("v2026.1")
  baseCustomerAmountUSD           Float                 @default(149)
  paymentFeeAmount                Float                 @default(0)
  customerTotalAmount             Float                 @default(149)
  currency                        String                @default("USD")
  status                          BookingStatus         @default(PENDING)
  attendanceSide                  WeddingSide           @default(OPEN)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  deletedAt                       DateTime?
  traveler                        TravelerProfile       @relation(fields: [travelerId], references: [id])
  wedding                         Wedding               @relation(fields: [weddingId], references: [id])
  guests                          BookingGuest[]
  cancellationRequests            CancellationRequest[]
  commissions                     Commission[]
  conversations                   Conversation[]
  emergencies                     EmergencyContact?
  guestPasses                     GuestPass[]
  payments                        Payment[]
  reviews                         Review[]
  safetyCases                     SafetyCase[]
  travelDetails                   TravelDetail?
  preparations                    TravelerPreparation?

  @@index([travelerId])
  @@index([weddingId])
  @@index([status])
  @@index([weddingTier])
  @@index([attendanceSide])
  @@index([createdAt])
}

model BookingGuest {
  id                String   @id @default(uuid())
  bookingId         String
  fullName          String
  email             String?
  age               Int?
  gender            String?
  foodPreference    String   @default("No Restrictions")
  accessibilityNeed String   @default("None")
  createdAt         DateTime @default(now())
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Wishlist {
  id             String          @id @default(uuid())
  travelerId     String
  weddingId      String
  folder         String          @default("Default")
  collection     String          @default("Favorites")
  notes          String?
  shareableToken String?         @unique
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  traveler       TravelerProfile @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  wedding        Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([travelerId, weddingId])
  @@index([travelerId])
  @@index([weddingId])
}

model Review {
  id                  String                   @id @default(uuid())
  bookingId           String
  travelerId          String
  rating              Int
  comment             String
  reply               String?
  status              String                   @default("PUBLISHED")
  type                ReviewType               @default(TRAVELER_TO_WEDDING)
  images              String[]
  helpfulVotes        Int                      @default(0)
  verifiedBooking     Boolean                  @default(true)
  ratingFood          Int                      @default(5)
  ratingHospitality   Int                      @default(5)
  ratingExperience    Int                      @default(5)
  ratingCulture       Int                      @default(5)
  ratingSafety        Int                      @default(5)
  ratingAccommodation Int                      @default(5)
  ratingOrganization  Int?
  ratingValue         Int?
  ratingCommunication Int?
  editedAt            DateTime?
  editCount           Int                      @default(0)
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  booking             Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveler            TravelerProfile          @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  appeals             ReviewAppeal[]
  fraudSignals        ReviewFraudSignal[]
  helpfulVotesList    ReviewHelpfulVote[]
  moderationActions   ReviewModerationAction[]
  repliesList         ReviewReply[]
  reports             ReviewReport[]

  @@index([bookingId, type])
  @@index([travelerId])
  @@index([status, type])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                    String          @id @default(uuid())
  bookingId             String
  provider              String          @default("MANUAL_PAYPAL")
  amount                Float
  baseAmount            Float?
  processingFeePercent  Float?
  processingFeeAmount   Float?
  totalAmount           Float?
  currency              String          @default("USD")
  paymentLink           String?
  transactionId         String?
  paymentNotes          String?
  paymentRequestedAt    DateTime?
  paidAt                DateTime?
  refundStatus          String?
  refundedAt            DateTime?
  refundNotes           String?
  refundTransactionId   String?
  stripePaymentIntentId String?         @unique
  stripeChargeId        String?         @unique
  hostPayoutTransferred Boolean         @default(false)
  status                PaymentStatus   @default(PENDING)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  commissions           Commission[]
  booking               Booking         @relation(fields: [bookingId], references: [id])
  paymentIntents        PaymentIntent[]
  payouts               Payout[]
  refunds               Refund[]
  transactions          Transaction[]

  @@index([bookingId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
}

model Transaction {
  id          String   @id @default(uuid())
  paymentId   String
  type        String
  amount      Float
  status      String
  referenceId String?
  metadata    String?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Refund {
  id                    String               @id @default(uuid())
  paymentId             String
  amount                Float
  reason                String?
  refundTransactionId   String?
  refundNotes           String?
  stripeRefundId        String?              @unique
  status                String
  createdAt             DateTime             @default(now())
  cancellationRequestId String?
  cancellationRequest   CancellationRequest? @relation(fields: [cancellationRequestId], references: [id])
  payment               Payment              @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([cancellationRequestId])
}

model Payout {
  id               String   @id @default(uuid())
  paymentId        String
  amount           Float
  stripeTransferId String?  @unique
  status           String
  createdAt        DateTime @default(now())
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model PaymentIntent {
  id           String   @id @default(uuid())
  paymentId    String
  stripeId     String   @unique
  clientSecret String
  amount       Float
  status       String
  createdAt    DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Commission {
  id                  String           @id @default(uuid())
  agentId             String
  referralId          String?
  bookingId           String?
  paymentId           String?
  transactionId       String?
  commissionRuleId    String?
  grossAmount         Float
  commissionAmount    Float
  currency            String           @default("USD")
  status              CommissionStatus @default(PENDING)
  source              String
  availableAt         DateTime?
  paidAt              DateTime?
  calculationSnapshot String?
  idempotencyKey      String?          @unique
  payoutRequestId     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  agent               AgentProfile     @relation(fields: [agentId], references: [id])
  booking             Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  commissionRule      CommissionRule?  @relation(fields: [commissionRuleId], references: [id])
  payment             Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payoutRequest       PayoutRequest?   @relation(fields: [payoutRequestId], references: [id])
  referral            AgentReferral?   @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([referralId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@index([agentId, status, payoutRequestId])
}

model AgentReferral {
  id             String              @id @default(uuid())
  agentId        String
  referredUserId String?
  referralCode   String
  referralType   ReferralType        @default(TRAVELER)
  status         ReferralStatus      @default(CLICKED)
  points         Int                 @default(0)
  visitorId      String
  sessionId      String?
  source         String?
  medium         String?
  campaign       String?
  landingPage    String?
  firstTouchAt   DateTime            @default(now())
  lastTouchAt    DateTime            @default(now())
  signedUpAt     DateTime?
  onboardedAt    DateTime?
  convertedAt    DateTime?
  expiresAt      DateTime?
  metadata       String?
  createdAt      DateTime            @default(now())
  agent          AgentProfile        @relation("Agent", fields: [agentId], references: [id])
  referredUser   User?               @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Restrict)
  commissions    Commission[]
  fraudFlags     ReferralFraudFlag[]

  @@index([agentId])
  @@index([referredUserId])
  @@index([visitorId])
  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
}

model Verification {
  id                  String             @id @default(uuid())
  userId              String             @unique
  status              VerificationStatus @default(NOT_SUBMITTED)
  passportUrl         String?
  govtIdUrl           String?
  selfieUrl           String?
  phoneVerified       Boolean            @default(false)
  emailVerified       Boolean            @default(false)
  invitationUrl       String?
  venueConfirmUrl     String?
  socialLinks         String?
  orgDetails          String?
  businessRegUrl      String?
  linkedinUrl         String?
  submissionDate      DateTime?          @default(now())
  notes               String?
  expiryDate          DateTime?
  reviewedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  aadhaarNumber       String?
  aadhaarUrl          String?
  addressProofUrl     String?
  availability        String?
  bankAccountNo       String?
  bankIfsc            String?
  bankName            String?
  bankVerificationUrl String?
  emergencyContact    String?
  experienceNotes     String?
  experienceYears     Int?
  gstNumber           String?
  gstUrl              String?
  languages           String?
  medicalDeclaration  String?
  nationality         String?
  panNumber           String?
  panUrl              String?
  portfolioUrl        String?
  references          String?
  travelInsuranceUrl  String?
  visaStatus          String?
  weddingProofUrl     String?
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  states    State[]
}

model State {
  id        String   @id @default(uuid())
  name      String
  countryId String
  createdAt DateTime @default(now())
  cities    City[]
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([name, countryId])
  @@index([countryId])
}

model City {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([name, stateId])
  @@index([stateId])
}

model Language {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HeroContent {
  id              String   @id @default(uuid())
  title           String
  subtitle        String
  buttonText      String?
  buttonLink      String?
  backgroundImage String?
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model HomepageStat {
  id        String   @id @default(uuid())
  label     String
  value     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  avatar    String?
  quote     String
  rating    Int      @default(5)
  featured  Boolean  @default(false)
