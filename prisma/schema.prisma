enum HostApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  VERIFIED
  APPROVED_FOR_LISTING
  REJECTED
  WITHDRAWN
}

model HostApplication {
  id                          String                  @id @default(uuid())
  userId                      String
  coupleProfileId             String?
  weddingId                   String?
  status                      HostApplicationStatus   @default(DRAFT)
  hostName                    String
  email                       String
  phone                       String?
  preferredContactMethod      String                  @default("WHATSAPP")
  brideName                   String?
  groomName                   String?
  coupleNames                 String
  city                        String
  state                       String?
  venueName                   String?
  weddingDate                 DateTime
  durationDays                Int                     @default(3)
  tradition                   String                  @default("Traditional / Cultural")
  weddingScale                String                  @default("MEDIUM")
  expectedTotalGuests         Int                     @default(200)
  expectedInternationalGuests Int                     @default(20)
  requestedTier               String                  @default("SIGNATURE_ROYAL")
  verifiedTier                String?
  verifiedDurationDays        Int?
  story                       String?
  adminNotesInternal          String?
  adminNotesHostFacing        String?
  reviewedBy                  String?
  reviewedAt                  DateTime?
  submittedAt                 DateTime?
  verifiedAt                  DateTime?
  lastSavedAt                 DateTime                @default(now())
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupleProfile               CoupleProfile?          @relation(fields: [coupleProfileId], references: [id], onDelete: SetNull)
  wedding                     Wedding?                @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  days                        HostApplicationDay[]
  documentRequests            HostDocumentRequest[]
  documents                   HostDocument[]
  auditLogs                   HostApplicationAuditLog[]

  @@index([userId])
  @@index([coupleProfileId])
  @@index([weddingId])
  @@index([status])
  @@index([weddingDate])
  @@index([createdAt])
}

model HostApplicationDay {
  id                          String                @id @default(uuid())
  applicationId               String
  dayNumber                   Int
  date                        DateTime
  title                       String
  description                 String?
  expectedInternationalGuests Int                   @default(20)
  guestExperience             String?
  foodExperience              String?
  dressCode                   String?
  specialActivities           String?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  application                 HostApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  events                      HostApplicationEvent[]

  @@unique([applicationId, dayNumber])
  @@index([applicationId])
}

model HostApplicationEvent {
  id          String             @id @default(uuid())
  dayId       String
  name        String
  startTime   String             @default("17:00")
  endTime     String             @default("22:00")
  location    String?
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  day         HostApplicationDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model HostDocumentRequest {
  id            String          @id @default(uuid())
  applicationId String
  userId        String
  requestType   String          @default("OTHER")
  title         String
  description   String
  isRequired    Boolean         @default(true)
  deadline      DateTime?
  status        String          @default("PENDING")
  requestedBy   String
  requestedAt   DateTime        @default(now())
  fulfilledAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     HostDocument[]

  @@index([applicationId])
  @@index([userId])
  @@index([status])
}

model HostDocument {
  id            String              @id @default(uuid())
  requestId     String
  applicationId String
  userId        String
  fileUrl       String
  fileKey       String?
  fileName      String
  fileSize      Int                 @default(0)
  mimeType      String              @default("application/octet-stream")
  uploadedAt    DateTime            @default(now())
  status        String              @default("SUBMITTED")
  adminFeedback String?
  request       HostDocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  application   HostApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([applicationId])
  @@index([userId])
}

model HostApplicationAuditLog {
  id            String          @id @default(uuid())
  applicationId String
  action        String
  actorId       String
  actorRole     String
  details       String?
  createdAt     DateTime        @default(now())
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([actorId])
}

